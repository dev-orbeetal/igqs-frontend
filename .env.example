NEXT_PUBLIC_API_URL=http://127.0.0.1:8855
# Production: https://igqsbd.com
# Vercel proxies /api and /media to the Django server.
# Public site: https://igqsbd.com
# Staff panel: https://admin.igqsbd.com

# Canonical origin for titles, canonical URLs, the sitemap, and Open Graph.
# Leave this as the production site even in local development.
NEXT_PUBLIC_SITE_URL=https://igqsbd.com

# Optional. Google Search Console HTML-tag token (the content value only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. GA4 measurement ID (G-XXXXXXXX). Analytics loads only when this is set.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only — never shipped to the browser. /staff-support reads this to
# redirect staff to webmail without putting the VPS IP in client JS.
STAFF_WEBMAIL_URL=https://84.247.174.208:41443/roundcube
